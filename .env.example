# Copie este arquivo para .env.local e preencha com as chaves do seu projeto.
# .env.local esta no .gitignore e nunca deve ser commitado.
#
# Onde achar: painel do Supabase > Project Settings > API
#   Project URL  -> NEXT_PUBLIC_SUPABASE_URL
#   anon public  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# A chave "anon" e publica por design: ela vai para o browser e a protecao
# real do dado e a Row Level Security do Postgres, nao o sigilo da chave.
# A chave "service_role" NUNCA entra aqui nem em qualquer variavel NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
